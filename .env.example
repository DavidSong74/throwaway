# Copy to .env, or export in your shell. Existing environment values take precedence.
DAYTONA_API_KEY=
NOSANA_API_KEY=
# Read a real available ID with: python3 -m tournament models
NOSANA_MODEL_ID=
NOSANA_API_BASE=https://inference.nosana.com/v1
# Optional: auto tries v2, falling back only if the account explicitly has v2 disabled.
DAYTONA_API_VERSION=auto
NOSANA_REQUEST_TIMEOUT=300
